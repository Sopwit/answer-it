<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AnswerIt" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/minimal_dark_primary</item>
        <item name="colorPrimaryVariant">@color/minimal_dark_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/minimal_dark_accent</item>
        <item name="colorSecondaryVariant">@color/minimal_dark_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/minimal_dark_bg</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/minimal_dark_bg</item>
        <item name="colorSurface">@color/minimal_dark_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
</resources> 