<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minimal_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="36dp">

        <!-- Trophy / Emblem Icon -->
        <ImageView
            android:id="@+id/logoIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_trophy"
            android:contentDescription="Trophy Emblem"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- App Title Area -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_message"
            android:textColor="@color/gold"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/logoIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle Badge -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ULTIMATE TRIVIA ARENA"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/welcomeText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Centered Menu Buttons Container -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@+id/subtitleText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Play Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/gold"
                android:text="@string/start_game"
                android:textColor="@color/black"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/black"
                app:iconSize="26dp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"
                app:elevation="8dp" />

            <!-- Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/minimal_dark_surface"
                android:text="@string/profile"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                app:iconSize="22dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="@color/stroke_dark"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/minimal_dark_surface"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                app:iconSize="22dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="@color/stroke_dark"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

            <!-- Exit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#26FF3D57"
                android:text="@string/exit"
                android:textColor="@color/red"
                android:textSize="15sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/red"
                app:iconSize="20dp"
                app:strokeColor="@color/red"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
