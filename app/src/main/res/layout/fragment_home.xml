<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minimal_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Hero Container (Logo & Title) -->
        <LinearLayout
            android:id="@+id/heroContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/menuContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <!-- Trophy / Emblem Icon -->
            <ImageView
                android:id="@+id/logoIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_trophy"
                android:contentDescription="Trophy Emblem"
                android:layout_marginBottom="16dp" />

            <!-- App Title Area -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANSWER IT"
                android:textColor="@color/gold"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:gravity="center" />

            <!-- Subtitle Badge -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ULTIMATE TRIVIA ARENA"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- Centered Menu Buttons Container -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@+id/heroContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Play Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="@color/gold"
                android:text="@string/start_game"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/black"
                app:iconSize="24dp"
                android:layout_marginBottom="14dp"
                app:cornerRadius="16dp"
                app:elevation="8dp" />

            <!-- Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/minimal_dark_surface"
                android:text="@string/profile"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                app:iconSize="22dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="@color/stroke_dark"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/minimal_dark_surface"
                android:text="@string/settings"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                app:iconSize="22dp"
                android:layout_marginBottom="12dp"
                app:strokeColor="@color/stroke_dark"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

            <!-- Exit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#26FF3D57"
                android:text="@string/exit"
                android:textColor="@color/red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/red"
                app:iconSize="20dp"
                app:strokeColor="@color/red"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
