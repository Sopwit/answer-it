<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minimal_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/themeTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_theme"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Theme Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/themeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/minimal_dark_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp">

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RadioButton
                    android:id="@+id/minimalDarkRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/minimal_dark"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/minimal_dark_primary" />

                <RadioButton
                    android:id="@+id/minimalLightRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/minimal_light"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/minimal_dark_primary" />

                <RadioButton
                    android:id="@+id/gradientBlueRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/gradient_blue"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/minimal_dark_primary" />

                <RadioButton
                    android:id="@+id/gradientPurpleRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/gradient_purple"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/minimal_dark_primary" />

                <RadioButton
                    android:id="@+id/gradientGoldRadio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/gradient_gold"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:buttonTint="@color/minimal_dark_primary" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/minimal_dark_surface"
            android:text="@string/back_to_menu"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:strokeColor="@color/stroke_dark"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
